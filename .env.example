# ResearchScope environment variables
# Copy this file to .env and fill in values as needed.
# None of these are required for the MVP — arXiv and ACL Anthology are public.

# Optional: Semantic Scholar API key for citation data
# SEMANTIC_SCHOLAR_KEY=your_key_here

# Optional: OpenAI-compatible key for LLM-powered enrichment (future)
# OPENAI_API_KEY=your_key_here

# Optional: Anthropic API key (future)
# ANTHROPIC_API_KEY=your_key_here

# ── Railway backend ───────────────────────────────────────────────────────────
# PostgreSQL URL from Railway dashboard (used by pipeline to sync papers)
# RAILWAY_DATABASE_URL=postgresql://user:pass@host:port/dbname

# FastAPI backend settings (set these in Railway environment variables)
# DATABASE_URL=postgresql://user:pass@host:port/dbname   (Railway provides this automatically)
# JWT_SECRET=your-secret-key-here
# JWT_TTL_HOURS=72
# PIPELINE_SECRET=your-pipeline-trigger-secret
# GITHUB_TOKEN=ghp_...                                   (fine-grained token with actions:write)
# GITHUB_REPO=kishormorol/ResearchScope
# GITHUB_WORKFLOW=pipeline.yml

# ── Chat with Paper (disabled until a provider is configured) ────────────────
# CHAT_ENABLED=false
# CHAT_PROVIDER=groq                    # groq | openai | anthropic
# CHAT_REQUEST_TIMEOUT_SECONDS=90
# CHAT_DAILY_MESSAGE_LIMIT=50
# CHAT_MAX_INPUT_CHARS=4000
# CHAT_MAX_OUTPUT_TOKENS=1200
# CHAT_MAX_PDF_MB=15
# CHAT_PDF_TIMEOUT_SECONDS=60
# CHAT_PDF_ALLOWED_HOSTS=
# GROQ_API_KEY=
# GROQ_CHAT_MODEL=
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_CHAT_MODEL=
# ALLOWED_ORIGINS=https://kishormorol.github.io,http://127.0.0.1:8080,http://localhost:8080

# Optional local-development metadata fallback. When the local papers table does
# not contain a selected production paper, validate and cache its metadata locally.
# PAPER_CATALOG_FALLBACK_URL=https://researchscope-production.up.railway.app
